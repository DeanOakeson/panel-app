rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The server writes user records through the Admin SDK, which skips these rules.
    // Clients can only read their own record, so nobody can set their own role.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Every other collection stays open until role-based rules replace this. Access
    // expires on 2026-12-15, after which all client requests are denied.
    match /{collection}/{document=**} {
      allow read, write: if collection != "users" && request.time < timestamp.date(2026, 12, 15);
    }
  }
}
