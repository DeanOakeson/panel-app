# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env.example is already tracked, so it is unaffected by this pattern
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temporary credentials created by google-github-actions/auth
gha-creds-*.json

# firebase emulators
.emulator-data
firebase-debug.log
firestore-debug.log
auth-debug.log
hub-debug.log
ui-debug.log
.firebase/
# per-developer local emulator config (off-default ports, not for the team)
firebase.emulator-test.json

# local run logs (dev server / emulator stdout captured by our harness)
/logs/
